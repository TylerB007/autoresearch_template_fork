{
  "name": "9mm-v3-rebalancer",
  "version": "1.0.0",
  "description": "Automated liquidity position rebalancer for 9mm DEX V3 on PulseChain",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "status": "tsx src/status.ts",
    "getchatid": "tsx src/getChatId.ts",
    "deploy": "bash scripts/deploy.sh",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs 9mm-rebalancer",
    "pm2:stop": "pm2 stop 9mm-rebalancer",
    "pm2:restart": "pm2 restart 9mm-rebalancer",
    "analytics": "tsx src/analytics-cli.ts",
    "analytics:status": "tsx src/analytics-cli.ts status",
    "analytics:history": "tsx src/analytics-cli.ts history",
    "analytics:summary": "tsx src/analytics-cli.ts summary",
    "analytics:record-fee": "tsx src/scripts/record-manual-fee-collection.ts",
    "analytics:backfill": "tsx src/scripts/backfill-history.ts",
    "analytics:backfill:dry": "tsx src/scripts/backfill-history.ts --dry-run",
    "analytics:patch-quality": "tsx src/scripts/patch-rebalance-quality.ts",
    "analytics:patch-quality:dry": "tsx src/scripts/patch-rebalance-quality.ts --dry-run",
    "audit:koinly": "tsx src/audit-cli.ts",
    "audit:koinly:pulsechain": "tsx src/audit-cli.ts --chain-id 369 --wallet \"ALM Pulsechain\"",
    "dashboard:dev": "tsx src/server/index.ts",
    "dashboard:start": "node dist/server/index.js",
    "recover": "node --enable-source-maps dist/manual-recover.js",
    "recover:dry": "tsx src/manual-recover.ts --dry-run",
    "force-rebalance": "tsx src/force-rebalance.ts",
    "force-rebalance:dry": "tsx src/force-rebalance.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integrity": "vitest run src/analytics/integrity.test.ts",
    "test:integrity:onchain": "RUN_ONCHAIN=1 vitest run src/analytics/integrity.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-telegram-bot-api": "^0.67.0",
    "winston": "^3.14.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
