# PRIVATE KEY — keep this secret! Never commit this file.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: Override RPC URLs (defaults are in config.yaml)
RPC_URL_PRIMARY=https://rpc.pulsechain.com
RPC_URL_FALLBACK_1=https://rpc-pulsechain.g4mm4.io
RPC_URL_FALLBACK_2=https://pulsechain-rpc.publicnode.com

# Telegram Bot (required for notifications and commands)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# DigitalOcean API Token (used by MCP server for cloud deployment)
DIGITALOCEAN_API_TOKEN=your_digitalocean_api_token_here

# Dashboard API (Express backend)
DASHBOARD_PASSWORD=your_secure_dashboard_password_here
DASHBOARD_JWT_SECRET=your_random_jwt_secret_here
DASHBOARD_PORT=3100
DASHBOARD_HOST=127.0.0.1
DASHBOARD_ORIGIN=https://143.110.130.198
