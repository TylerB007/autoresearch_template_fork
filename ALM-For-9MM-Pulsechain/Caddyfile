# Caddy reverse proxy for 9mm Rebalancer Dashboard
# Uses self-signed TLS (no domain name configured)
# To switch to Let's Encrypt: replace `tls internal` with `tls your@email.com`
# and change the address to your domain name

143.110.130.198:443 {
    reverse_proxy 127.0.0.1:3100
    tls internal
}

:80 {
    redir https://143.110.130.198{uri} permanent
}
